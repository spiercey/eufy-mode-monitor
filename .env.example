# eufy account. Copy this file to `.env` and fill in your details.
# `.env` is gitignored.
EUFY_EMAIL=you@example.com
EUFY_COUNTRY=CA

# Password is NOT stored here. Sign in once with `npm run auth` — the password is used only in
# memory and only the session token is saved (to .eufy-session.json). Re-run `npm run auth` if the
# session expires (e.g. after a password change).
#
# Optional: if you set EUFY_PASSWORD below, the tools will also re-authenticate automatically when
# the token expires (at the cost of keeping the password on disk). Leave it unset to avoid that.
# EUFY_PASSWORD=your-password

# --- guard_sync options (all optional) ---
# Poll interval in seconds for guard_sync.ts (default 60).
# GUARD_INTERVAL=60
# Pin the house / station / change-log name instead of auto-discovering them.
# GUARD_HOUSE_ID=
# GUARD_STATION_SN=
# GUARD_USER_NAME=

# Turn on SDK debug logging.
# EUFY_DEBUG=1
